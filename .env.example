# Copy to .env.local (git-ignored) and fill in what you need. Every value is optional.
# These are read at build time, so rebuild after changing them.

# The central InPhox app (platform), with no path. Default: https://platform.inphox.net
# Used for two forms, never for payment:
#   - the Start page's Create account POSTs owner_name, company_name, email, plan and interval
#     to <platform>/inphox/signup (it emails a confirmation link; the shop is then created);
#   - the Contact form POSTs name, email, company, segment and volume to <platform>/inphox/lead.
# Set it to off for a local preview that must not create sign-ups: both forms stay client-side.
# The website never takes payment: plan buttons always continue to the Start page,
# and the plan is paid for inside the shop's app at the end of setup.
VITE_PLATFORM_URL=

# phone-intake's billing service (e.g. https://intake.inphox.net): sign-ups go there instead
# (<base>/billing/signup, <base>/billing/lead) while VITE_PLATFORM_URL is not set.
VITE_BILLING_BASE_URL=

# The domain shops live under. Sign in opens the site's "Sign in to your shop" page, which sends
# people to https://<shop>.<this domain>/web/login (their shop's InPhox app). Default: inphox.net
VITE_SHOP_DOMAIN=
