# Copy to .env.local (git-ignored) and fill in what you need. Every value is optional.
# These are read at build time, so rebuild after changing them.

# Base URL of the InPhox billing service, with no path, e.g. https://intake.inphox.net
# Set: plan buttons POST plan, interval and payment_mode to <base>/billing/checkout,
#      and the Contact form POSTs name, email, company, segment and volume to <base>/billing/lead.
# Unset: plan buttons continue to the Start page, and the Contact form stays client-side only.
VITE_BILLING_BASE_URL=

# Where every Sign in link goes. Default: https://intake.inphox.net/auth/login
VITE_APP_LOGIN_URL=
