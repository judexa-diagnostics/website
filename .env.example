# Copy to .env.local (git-ignored) and fill in what you need. Every value is optional.
# These are read at build time, so rebuild after changing them.

# Base URL of the InPhox billing service, with no path, e.g. https://intake.inphox.net
# Used for two forms, never for payment:
#   - the Start page's Create account POSTs owner_name, company_name, email, plan and interval
#     to <base>/billing/signup (phone-intake emails a confirmation link; the shop is then created);
#   - the Contact form POSTs name, email, company, segment and volume to <base>/billing/lead.
# Unset: both forms stay client-side only.
# The website never takes payment: plan buttons always continue to the Start page,
# and the plan is paid for inside the app at the end of shop setup.
VITE_BILLING_BASE_URL=

# Where every Sign in link goes. Default: https://intake.inphox.net/auth/login
VITE_APP_LOGIN_URL=
